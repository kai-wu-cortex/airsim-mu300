#!/bin/sh /etc/rc.common
START=98
STOP=09
USE_PROCD=1

start_service() {
    local root=/mnt/mu300-disk/extra/airsim-f50
    [ -x "$root/f50-private-mount" ] || return 1
    procd_open_instance
    procd_set_param command "$root/f50-private-mount" /bin/sh "$root/boot-lan.sh"
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
